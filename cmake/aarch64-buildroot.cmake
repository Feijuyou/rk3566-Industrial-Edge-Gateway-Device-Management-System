# 前缀包含工具链目录和结尾的短横线，详见 README_MQTT.md。
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if("$ENV{RK3566_CROSS_COMPILE}" STREQUAL "" OR "$ENV{RK3566_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR "请设置 RK3566_CROSS_COMPILE 和 RK3566_SYSROOT")
endif()
set(CMAKE_C_COMPILER "$ENV{RK3566_CROSS_COMPILE}gcc")
set(CMAKE_CXX_COMPILER "$ENV{RK3566_CROSS_COMPILE}g++")
set(CMAKE_SYSROOT "$ENV{RK3566_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
